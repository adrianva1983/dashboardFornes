	<script src="js/barcoder.js"></script>
	
	<script>
	function asignar_tarjeta(parametro)
	{
		var validator = new Barcoder('ean13');
		if (parseInt($('#NUMERO_TARJETA').val())>999999999999&&parseInt($('#NUMERO_TARJETA').val())<10000000000000)
		{
			if (validator.validate($('#NUMERO_TARJETA').val()))
			{
				return true;
			}
			else
			{
				if (parametro==0)
				{
					swal({
						title: "Problemas encontrados!",
						text: "EAN13 de tarjeta de cliente con formato incorrecto.",
						html: true,
						type: "error"
					});
				}
				return false;
			}		
		}
		else 
		{
			if (parametro==0)
			{
				swal({
						title: "Problemas encontrados!",
						text: "EAN13 de tarjeta de cliente con número de dígitos incorrecto.",
						html: true,
						type: "error"
					});
				return false;
			}
			else 
			{
				if ($('#NUMERO_TARJETA').val()!='') return false;
				else return true;
			}
		}
	}
	function validateEmail(email) {
		var re = /^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
		return re.test(email);
	}
	function validarFormatoFecha(campo) {
		var RegExPattern = /^\d{1,2}\/\d{1,2}\/\d{2,4}$/;
		if ((campo.match(RegExPattern)) && (campo!='')) return true;
		else return false;
	}
	function validarForm() 
	{		
		var texto_errores = '';
		if (!asignar_tarjeta(1)) texto_errores += "Tarjeta con formato incorrecto.<br/>";
		if ($('#MOVIL').val()==''&&$('#TELEFONO').val()=='') texto_errores += "Es obligatorio al menos un teléfono de contacto.<br/>";
		if ($('#MOVIL').val()!=''&&(parseInt($('#MOVIL').val())<=99999999||parseInt($('#MOVIL').val())>999999999)) texto_errores += "El teléfono móvil no tiene un formato correcto.<br/>";
		if ($('#TELEFONO').val()!=''&&(parseInt($('#TELEFONO').val())<=99999999||parseInt($('#TELEFONO').val())>999999999)) texto_errores += "El teléfono fijo no tiene un formato correcto.<br/>";
		if ($('#EMAIL').val()!=''&&!validateEmail($('#EMAIL').val())) texto_errores += "El email no tiene formato correcto.<br/>";
		if ($('#COD_POSTAL').val()!=''&&(parseInt($('#COD_POSTAL').val())<=9999||parseInt($('#COD_POSTAL').val())>99999)) texto_errores+= "El Código postal no tiene un formato correcto<br/>";
		if ($('#FECHA_NACIMIENTO').val()!=''&&!validarFormatoFecha($('#FECHA_NACIMIENTO').val())) texto_errores+= "La fecha de nacimiento no tiene un formato correcto.<br/>";
		if ($('#tipo_documento').val()!='Otro') if (!nif_correcto($('#DNI_CLIENTE').val())) texto_errores += "El DNI no tiene un formato correcto.<br/>";
		if (texto_errores!='')
		{
			swal({
				title: "Problemas encontrados!",
				text: texto_errores,
				html: true,
				type: "error"
			});
			return false;
		}
		else return true;
	}
	function nif_correcto(dni)
	{
		var numero;
		var letr;
		var letra;
		var expresion_regular_dni;
		expresion_regular_dni = /^\d{8}[a-zA-Z]$/;
		if(expresion_regular_dni.test (dni) == true)
		{
			numero = dni.substr(0,dni.length-1);
			letr = dni.substr(dni.length-1,1);
			numero = numero % 23;
			letra='TRWAGMYFPDXBNJZSQVHLCKET';
			letra=letra.substring(numero,numero+1);
			if (letra!=letr.toUpperCase()) 
			{				
				return false;				
			}
			else
			{
				
				return true;
			}
		}
		else
		{
			return false;
		}
	}
	function pintar_fechas_hijos()
	{
		var num_hijos = $('#HIJOS_HOGAR').val();
		var html_fechas_hijos = '';
		for (var indice_tmp=0;indice_tmp<num_hijos;indice_tmp++)
		{
			var tmp_valor_fecha ='';
			if ($('#FECHA_NACIMIENTO'+indice_tmp).val()!=undefined&&$('#FECHA_NACIMIENTO'+indice_tmp).val()!='') tmp_valor_fecha = $('#FECHA_NACIMIENTO'+indice_tmp).val();
			html_fechas_hijos += '<div class="input-group m-b"><label for="FECHA_NACIMIENTO'+indice_tmp+'">Fecha nacimiento hijo '+(indice_tmp+1)+'</label><input value="'+tmp_valor_fecha+'" name="FECHA_NACIMIENTO'+indice_tmp+'" data-mask="99/99/9999" id="FECHA_NACIMIENTO'+indice_tmp+'" type="text" placeholder="dd/mm/aaaa" class="form-control"></div>';						
		}
		$('#FECHAS_HIJOS').html(html_fechas_hijos);
	}
	function cargar_datos_personales(dni_cliente)
	{
		$('#tarjetas tbody').html('');
		$.ajax({
			type:'GET',
			timeout: 3000,
			dataType: 'json',
			url:'http://masymas-services.supermasymas.com/servicios/cargar_datos_personales.php?key_acceso=c5zwCl4e1vw5oY609T5GX4rD71UVx1Rf&dni_cliente='+dni_cliente,
			success:function(res, textStatus, XMLHttpRequest)
			{	
				$('#ORIGEN').val(res.ORIGEN);
				$('#ID_CLIENTE').val(res.ID_CLIENTE);
				$('#NOMBRE').val(res.NOMBRE);
				$('#APELLIDOS').val(res.APELLIDOS);			
				$('#SEXO option[value="'+res.SEXO+'"]').prop("selected", "selected");
				$('#ESTADO_CIVIL option[value="'+res.ESTADO_CIVIL+'"]').prop("selected", "selected");
				$('#NACIONALIDAD').val(res.NACIONALIDAD);
				$('#TIPO_DIRECCION option[value="'+res.TIPO_DIRECCION+'"]').prop("selected", "selected");
				$('#DIRECCION').val(res.DIRECCION);
				$('#NUMERO').val(res.NUMERO);
				$('#PISO_LETRA_OTROS').val(res.PISO_LETRA_OTROS);
				$('#POBLACION').val(res.POBLACION);
				$('#COD_POSTAL').val(res.COD_POSTAL);
				$('#PROVINCIA').val(res.PROVINCIA);
				$('#TELEFONO').val(res.TELEFONO);
				$('#CAJERA').val(res.CODIGO_CAJERA);
				if (res.ENVIO_PUBLICIDAD=='S') 
				{
					$("#PUBLICIDAD_SI").iCheck('check');					
					$("#PUBLICIDAD_NO").iCheck('uncheck');
				}
				else 
				{
					$("#PUBLICIDAD_NO").iCheck('check');
					$("#PUBLICIDAD_SI").iCheck('uncheck');
				}
				$('#FECHA_NACIMIENTO').val(res.FECHA_NACIMIENTO);
				$('#PERS_UNIDAD_FAM option[value="'+res.PERS_UNIDAD_FAM+'"]').prop("selected", "selected");
				$('#HIJOS_HOGAR option[value="'+res.HIJOS_HOGAR+'"]').prop("selected", "selected");
				if (res.HIJOS_HOGAR>0)
				{					
					var html_fechas_hijos ='';
					for (var indice_tmp=0;indice_tmp<res.HIJOS_HOGAR;indice_tmp++)
					{						
						var objeto_nacimiento = null;												
						if (res.FECHAS_NAC_HIJOS!=undefined) 
						{
							if (res.FECHAS_NAC_HIJOS.length>indice_tmp) objeto_nacimiento = res.FECHAS_NAC_HIJOS[indice_tmp];
						}						
						if (objeto_nacimiento!=null) html_fechas_hijos += '<div class="input-group m-b"><label for="FECHA_NACIMIENTO'+indice_tmp+'">Fecha nacimiento hijo '+(indice_tmp+1)+'</label><input value="'+objeto_nacimiento.FECHA_NACIMIENTO+'" name="FECHA_NACIMIENTO'+indice_tmp+'" data-mask="99/99/9999" id="FECHA_NACIMIENTO'+indice_tmp+'" type="text" placeholder="dd/mm/aaaa" class="form-control"></div>';
						else html_fechas_hijos += '<div class="input-group m-b"><label for="FECHA_NACIMIENTO'+indice_tmp+'">Fecha nacimiento hijo '+(indice_tmp+1)+'</label><input value="" name="FECHA_NACIMIENTO'+indice_tmp+'" data-mask="99/99/9999" id="FECHA_NACIMIENTO'+indice_tmp+'" type="text" placeholder="dd/mm/aaaa" class="form-control"></div>';						
					}
					$('#FECHAS_HIJOS').html(html_fechas_hijos);					
				}
				$('#MOVIL').val(res.MOVIL);
				$('#EMAIL').val(res.EMAIL);
				var indice = 0;
				var html_tmp = '';	
				console.log[res.TARJETAS];				
				while (res.TARJETAS[indice])
				{
					var campo = res.TARJETAS[indice];
					var fecha_txt ='';					
					var fecha_alta_tarjeta ='';
					if (campo['FECHA_ALTA_TARJETA']!=null) fecha_alta_tarjeta = campo['FECHA_ALTA_TARJETA']
					//var fecha_alta_tarjeta = campo['FECHA_ALTA_TARJETA'];
					//var tmp_array = [];
					//if (fecha_alta_tarjeta!=null)
					//{
						//tmp_array = fecha_alta_tarjeta.split('-');
						//if (tmp_array.length()>0) fecha_txt = tmp_array[2]+'/'+tmp_array[1]+'/'+tmp_array[0];
					//}
					//var fecha_txt ='';
					html_tmp += '<tr><td>'+campo['CODIGO_TARJETA']+'</td><td>'+campo['BAJA']+'</td><td>'+fecha_alta_tarjeta+'</td></tr>';
					indice++;
				}		
				$('#tarjetas tbody').html(html_tmp);
			},
			error: function(XMLHttpRequest, textStatus, errorThrown) 
			{
				swal({
					title: "Problemas encontrados!",
					text: "Problema con la conexión, reinténtalo por favor.",
					html: true,
					type: "error"
				});
			}
		});	
	}
	function tarjeta_cargado()
	{
		$.ajax({
			type:'GET',
			timeout: 3000,
			dataType: 'json',
			url:'http://masymas-services.supermasymas.com/servicios/cargar_dni_tarjeta.php?key_acceso=c5zwCl4e1vw5oY609T5GX4rD71UVx1Rf&cod_cliente='+$('#buscar_por_tarjeta').val(),
			success:function(res, textStatus, XMLHttpRequest)
			{	
				$('#DNI_CLIENTE').val(res.DNI);
				cargar_datos_personales(res.DNI);
			},
			error: function(XMLHttpRequest, textStatus, errorThrown) 
			{
				swal({
					title: "Problemas encontrados!",
					text: "Problema con la conexión, reinténtalo por favor.",
					html: true,
					type: "error"
				});
			}
		});
	}
	function dni_cargado()
	{
		var correcto = true;
		if ($('#tipo_documento').val()!='Otro')
		{
			correcto = nif_correcto($('#DNI_CLIENTE').val());
			if (correcto){}
			else 
			{
				swal({
					title: "Problemas encontrados!",
					text: "DNI con formato incorrecto.",
					html: true,
					type: "error"
				});
			}			
		}
		if (correcto)
		{
			cargar_datos_personales($('#DNI_CLIENTE').val());
		}
	}
	function restablecer()
	{
		$('#FECHAS_HIJOS').html('');
	}
	</script>
